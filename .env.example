# =============================================================================
# CẤU HÌNH ỨNG DỤNG QUẢN LÝ CÔNG VIỆC
#
# Cách dùng: sao chép file này thành .env rồi điền giá trị thật
#   cp .env.example .env
#
# ⚠️  KHÔNG BAO GIỜ commit file .env lên git — nó chứa mật khẩu ứng dụng Gmail
#     (cho toàn quyền truy cập hộp thư) và khóa ký liên kết xác nhận.
# =============================================================================

# --- Môi trường chạy ---------------------------------------------------------
# development = chạy trên máy cá nhân · production = chạy trên VPS
# ⚠️ Đặt production mà chưa bật BAT_AUTH thì app sẽ TỪ CHỐI khởi động (cố ý).
NODE_ENV=development

# Cổng của API. Frontend đã cấu hình proxy sang cổng này.
PORT=3001


# --- Cơ sở dữ liệu -----------------------------------------------------------
# Chạy local trên Mac (PostgreSQL cài qua Homebrew, không cần mật khẩu):
DATABASE_URL=postgresql://tuantoha@localhost:5432/ceo_quanly?schema=public
#
# Khi lên VPS, chỉ cần đổi ĐÚNG DÒNG NÀY, không sửa dòng code nào:
# DATABASE_URL=postgresql://nguoidung:matkhau@may-chu:5432/ceo_quanly?schema=public


# --- Tệp đính kèm ------------------------------------------------------------
# Thư mục lưu tệp người dùng tải lên (tương đối so với apps/api/).
# Nhớ sao lưu thư mục này cùng với database.
UPLOAD_DIR=./uploads


# --- Múi giờ -----------------------------------------------------------------
# Dùng để tính "số ngày còn lại" theo ranh giới ngày Việt Nam.
MUI_GIO=Asia/Ho_Chi_Minh


# --- Xác thực ----------------------------------------------------------------
# false = không cần đăng nhập (chỉ dùng khi chạy local trên máy cá nhân)
# true  = đã cài đặt xác thực trong auth.middleware.ts, cho phép chạy production
BAT_AUTH=false


# --- Địa chỉ công khai (tùy chọn) --------------------------------------------
# Để TRỐNG khi chạy local → email giao việc chỉ ghi "trả lời email này khi xong".
# Khi lên VPS hoặc chạy cloudflared tunnel → điền vào đây, email sẽ tự động kèm
# nút "Xác nhận đã hoàn thành". Không cần sửa code.
# PUBLIC_BASE_URL=https://congviec.tencongty.com


# =============================================================================
# EMAIL (dùng ở giai đoạn 4 — để trống cũng chạy được các giai đoạn trước)
# =============================================================================

# Địa chỉ Gmail dùng để gửi và nhận email giao việc.
GMAIL_DIA_CHI=

# Mật khẩu ứng dụng (App Password) — KHÔNG phải mật khẩu Gmail thường.
#
# Cách lấy:
#   Bước 1: BẮT BUỘC bật Xác minh 2 bước trước
#           https://myaccount.google.com/signinoptions/twosv
#           (chưa bật thì bước 2 sẽ không hiện tùy chọn nào)
#   Bước 2: Tạo mật khẩu ứng dụng
#           https://myaccount.google.com/apppasswords
#
# ⚠️ Google hiển thị dạng "abcd efgh ijkl mnop" — DÁN VÀO ĐÂY PHẢI BỎ HẾT DẤU CÁCH,
#    thành 16 ký tự liền nhau. Đây là lỗi phổ biến nhất khi cấu hình.
# ⚠️ Nghi bị lộ? Vào lại trang trên bấm xóa và tạo cái mới — mật khẩu Gmail
#    chính của bạn không bị ảnh hưởng.
GMAIL_APP_PASSWORD=

# Khóa bí mật để ký liên kết xác nhận hoàn thành gửi trong email.
# Sinh khóa mới bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAGIC_LINK_SECRET=
